---
import '../styles/global.css';
import { site, siteText } from '../data/site';
import { url } from '../data/url';
import { homePath, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Adres tej samej strony w drugim języku */
  alternate: string;
  isHome?: boolean;
  title?: string;
  description?: string;
}

const { lang, alternate, isHome = false, title, description = siteText[lang].tagline } = Astro.props;
const t = useTranslations(lang);
const otherLang: Lang = lang === 'pl' ? 'en' : 'pl';
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${siteText[lang].role}`;
const base = isHome ? '' : homePath(lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="alternate" hreflang={lang} href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="alternate" hreflang={otherLang} href={new URL(alternate, Astro.site)} />
    <script is:inline define:vars={{ pageLang: lang, alternate }}>
      // Wybór języka: zapisany wybór użytkownika > język systemu (polski → PL, inny → EN)
      try {
        let target = localStorage.getItem('lang');
        if (target !== 'pl' && target !== 'en') {
          const prefs = navigator.languages?.length ? navigator.languages : [navigator.language];
          const match = prefs.map((l) => l.toLowerCase().slice(0, 2)).find((l) => l === 'pl' || l === 'en');
          target = match ?? 'en';
        }
        if (target !== pageLang) location.replace(alternate + location.hash);
        // Po przełączeniu języka ukryj stronę do czasu przywrócenia pozycji przewijania
        if (sessionStorage.getItem('langSwitchScroll')) document.documentElement.style.visibility = 'hidden';
      } catch {}
    </script>
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;700&display=swap"
    />
    <script is:inline>
      (() => {
        let theme = 'dark';
        try {
          theme = localStorage.getItem('theme') ?? (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        } catch {}
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{t('nav.skip')}</a>

    <header class="nav">
      <div class="container nav-inner">
        <a href={homePath(lang)} class="logo" aria-label={`${site.name} — ${t('nav.home')}`}>
          {site.name}
        </a>
        <nav aria-label={t('nav.aria')}>
          <ul>
            <li><a href={`${base}#projekty`}>{t('nav.projects')}</a></li>
            <li><a href={`${base}#o-mnie`}>{t('nav.about')}</a></li>
            <li><a href={`${base}#umiejetnosci`}>{t('nav.skills')}</a></li>
            <li><a href={`${base}#kontakt`}>{t('nav.contact')}</a></li>
          </ul>
        </nav>
        <a
          class="lang-switch mono"
          href={alternate}
          hreflang={otherLang}
          lang={otherLang}
          data-lang={otherLang}
          aria-label={t('nav.switchLang')}
        >
          {otherLang.toUpperCase()}
        </a>
        <button class="theme-toggle" type="button" aria-label={t('nav.theme')}>
          <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path></svg>
          <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg>
        </button>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="container footer-inner mono">
        <span>© {new Date().getFullYear()} {site.name}</span>
        <span>{t('footer.sheet')}</span>
      </div>
    </footer>

    <script is:inline>
      // Przełączanie języka zostawia użytkownika w tym samym miejscu strony.
      // Obie wersje językowe mają identyczną strukturę, więc pozycję zapisujemy
      // jako indeks bloku + przesunięcie wewnątrz niego.
      (() => {
        const blocks = () => [...document.querySelectorAll('main section, main header, main figure, main .layout, main .pager, footer')];
        const html = document.documentElement;

        try {
          const saved = JSON.parse(sessionStorage.getItem('langSwitchScroll') ?? 'null');
          sessionStorage.removeItem('langSwitchScroll');
          if (saved) {
            const restore = () => {
              const el = blocks()[saved.index];
              const top = el ? el.getBoundingClientRect().top + scrollY + saved.offset : saved.y;
              scrollTo({ top, behavior: 'instant' });
            };
            restore();
            // Fonty i obrazy mogą jeszcze zmienić wysokość bloków — poprawiaj pozycję,
            // dopóki strona się nie ustabilizuje albo użytkownik sam nie zacznie przewijać
            let userScrolled = false;
            const stop = () => (userScrolled = true);
            ['wheel', 'touchstart', 'keydown', 'pointerdown'].forEach((type) =>
              addEventListener(type, stop, { once: true, passive: true }),
            );
            const settle = () => {
              if (!userScrolled) restore();
            };
            addEventListener('DOMContentLoaded', settle, { once: true });
            document.fonts?.ready.then(settle);
            addEventListener('load', () => {
              settle();
              setTimeout(settle, 150);
            }, { once: true });
          }
        } catch {}
        html.style.visibility = '';

        document.querySelector('.lang-switch')?.addEventListener('click', (event) => {
          const link = event.currentTarget;
          try {
            localStorage.setItem('lang', link.dataset.lang ?? '');
            const list = blocks();
            let index = 0;
            list.forEach((el, i) => {
              if (el.getBoundingClientRect().top <= 1) index = i;
            });
            const offset = list[index] ? -list[index].getBoundingClientRect().top : scrollY;
            sessionStorage.setItem('langSwitchScroll', JSON.stringify({ index, offset, y: scrollY }));
          } catch {}
        });
      })();
    </script>

    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
      toggle?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {}
      });
    </script>

    <style>
      .skip {
        position: absolute;
        left: 16px;
        top: -60px;
        z-index: 100;
        background: var(--accent);
        color: var(--on-accent);
        padding: 10px 16px;
        border-radius: var(--radius);
        text-decoration: none;
      }

      .skip:focus {
        top: 16px;
      }

      .nav {
        position: sticky;
        top: 0;
        z-index: 50;
        background: color-mix(in srgb, var(--bg) 85%, transparent);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--border);
      }

      .nav-inner {
        display: flex;
        align-items: center;
        gap: 24px;
        height: 64px;
      }

      .logo {
        font-size: 16px;
        font-weight: 500;
        white-space: nowrap;
        text-decoration: none;
        color: var(--text);
        transition: color 200ms var(--ease);
      }

      .logo:hover {
        color: var(--accent);
      }

      nav {
        margin-left: auto;
      }

      nav ul {
        display: flex;
        gap: 4px;
        list-style: none;
        margin: 0;
        padding: 0;
      }

      nav a {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        padding: 0 12px;
        color: var(--text-muted);
        text-decoration: none;
        font-size: 15px;
        transition: color 200ms var(--ease);
      }

      nav a:hover {
        color: var(--text);
      }

      .lang-switch {
        display: grid;
        place-items: center;
        width: 44px;
        height: 44px;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: var(--surface);
        color: var(--text);
        font-size: 13px;
        font-weight: 500;
        text-decoration: none;
        transition:
          border-color 200ms var(--ease),
          color 200ms var(--ease);
      }

      .lang-switch:hover {
        border-color: var(--accent);
        color: var(--accent);
      }

      .theme-toggle {
        display: grid;
        place-items: center;
        width: 44px;
        height: 44px;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: var(--surface);
        color: var(--text);
        cursor: pointer;
        transition: border-color 200ms var(--ease);
      }

      .theme-toggle:hover {
        border-color: var(--accent);
      }

      .theme-toggle svg {
        width: 18px;
        height: 18px;
      }

      :global([data-theme='dark']) .icon-moon,
      :global([data-theme='light']) .icon-sun {
        display: none;
      }

      .footer {
        border-top: 1px solid var(--border);
        background: var(--bg);
      }

      .footer-inner {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        padding-top: 24px;
        padding-bottom: 24px;
        font-size: 13px;
        color: var(--text-muted);
      }

      @media (max-width: 720px) {
        .nav-inner {
          flex-wrap: wrap;
          height: auto;
          row-gap: 0;
          padding-top: 10px;
        }

        nav {
          order: 3;
          width: 100%;
          margin: 0;
        }

        nav ul {
          justify-content: space-between;
          gap: 0;
          margin: 0 -8px;
        }

        nav a {
          padding: 0 8px;
          font-size: 14px;
          white-space: nowrap;
        }

        .lang-switch {
          margin-left: auto;
        }
      }
    </style>
  </body>
</html>
