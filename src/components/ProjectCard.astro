---
import { Image } from 'astro:assets';
import type { LocalizedProject } from '../i18n/projects';
import { projectPath, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  project: LocalizedProject;
  lang: Lang;
}

const { project, lang } = Astro.props;
const t = useTranslations(lang);
const { title, summary, category, cover, coverAlt, date } = project.entry.data;
---

<article class="card">
  <div class="media">
    <Image src={cover} alt={coverAlt} widths={[480, 800]} sizes="(max-width: 720px) 100vw, 480px" loading="lazy" />
  </div>
  <p class="label">{t(`cat.${category}`)} · {date.getFullYear()}</p>
  <h3>
    <a href={projectPath(lang, project.slug)}>{title}</a>
  </h3>
  <p class="summary">{summary}</p>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .media {
    aspect-ratio: 3 / 2;
    margin-bottom: 8px;
    background: var(--surface);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms var(--ease);
  }

  .card:hover .media :global(img) {
    transform: scale(1.02);
  }

  h3 {
    font-size: 20px;
  }

  h3 a {
    text-decoration: none;
  }

  .card:hover h3 a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Cała karta klikalna, link pozostaje jednym elementem dla czytnika ekranu */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .summary {
    color: var(--text-muted);
    font-size: 15px;
  }
</style>
