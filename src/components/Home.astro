---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import cswa from '../assets/cswa.png';
import ProjectCard from './ProjectCard.astro';
import { site, siteText } from '../data/site';
import { getProjects } from '../i18n/projects';
import { homePath, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const text = siteText[lang];
const projects = await getProjects(lang);
---

<Base lang={lang} alternate={homePath(lang === 'pl' ? 'en' : 'pl')} isHome>
  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <p class="label">{text.role} · {text.location}</p>
      <h1>{site.name}</h1>
      <p class="lead">{text.tagline}</p>
      <div class="actions">
        <a class="btn btn-primary" href="#projekty">{t('hero.cta')}</a>
        <a class="btn" href="#kontakt">{t('hero.contact')}</a>
      </div>
    </div>
  </section>

  <!-- PROJEKTY -->
  <section id="projekty" class="section">
    <div class="container">
      <h2 class="section-title">{t('projects.title')}</h2>
      <div class="grid">
        {projects.map((project) => <ProjectCard project={project} lang={lang} />)}
      </div>
    </div>
  </section>

  <!-- O MNIE -->
  <section id="o-mnie" class="section">
    <div class="container split">
      <h2 class="section-title">{t('about.title')}</h2>
      <div class="about-text">
        {text.about.map((paragraph) => <p>{paragraph}</p>)}
        <a
          class="badge"
          href="https://www.credly.com/badges/0803862d-f325-4ea4-9b01-9cfc5996a36e/public_url"
          target="_blank"
          rel="noopener noreferrer"
        >
          <Image src={cswa} alt="" widths={[128, 256]} sizes="64px" loading="lazy" />
          <span>
            <strong>Certified SOLIDWORKS Design Associate</strong>
            <span class="label">Dassault Systèmes · 2026</span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- UMIEJĘTNOŚCI -->
  <section id="umiejetnosci" class="section">
    <div class="container split">
      <h2 class="section-title">{t('skills.title')}</h2>
      <dl class="skills">
        {
          text.skills.map((group) => (
            <div>
              <dt>{group.group}</dt>
              <dd>{group.items.join(' · ')}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- KONTAKT -->
  <section id="kontakt" class="section">
    <div class="container split">
      <h2 class="section-title">{t('contact.title')}</h2>
      <div>
        <p class="contact-lead">{t('contact.lead')}</p>
        <div class="actions">
          <a class="btn btn-primary" href={`mailto:${site.email}?subject=${encodeURIComponent(text.mailSubject)}`}>
            <span class="email">{site.email}</span>
          </a>
          <a class="btn" href={site.github} target="_blank" rel="noopener noreferrer">GitHub</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding: 120px 0 104px;
  }

  h1 {
    font-size: clamp(40px, 6vw, 64px);
    letter-spacing: -0.03em;
    margin: 12px 0 20px;
  }

  .lead {
    font-size: clamp(18px, 2vw, 21px);
    color: var(--text-muted);
    max-width: 40ch;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr));
    gap: 48px 32px;
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 48px;
  }

  .split .section-title {
    margin-bottom: 0;
  }

  .about-text {
    display: grid;
    gap: 20px;
    font-size: 17px;
    color: var(--text-muted);
    max-width: 62ch;
  }

  .badge {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 8px;
    padding: 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    transition: border-color 200ms var(--ease);
  }

  .badge:hover {
    border-color: var(--border-strong);
  }

  .badge :global(img) {
    width: 64px;
    height: 64px;
    flex-shrink: 0;
  }

  .badge > span {
    display: grid;
    gap: 2px;
  }

  .badge strong {
    font-size: 16px;
    font-weight: 500;
    color: var(--text);
  }

  .skills {
    margin: 0;
    display: grid;
  }

  .skills div {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--border);
  }

  .skills div:first-child {
    padding-top: 0;
  }

  .skills div:last-child {
    border-bottom: 0;
  }

  .skills dt {
    font-weight: 500;
  }

  .skills dd {
    margin: 0;
    color: var(--text-muted);
  }

  .contact-lead {
    font-size: 17px;
    color: var(--text-muted);
  }

  .actions .btn {
    max-width: 100%;
  }

  .email {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  @media (max-width: 800px) {
    .hero {
      padding: 72px 0 64px;
    }

    .split {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }

    .skills div {
      grid-template-columns: minmax(0, 1fr);
      gap: 4px;
    }
  }
</style>
