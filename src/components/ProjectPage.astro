---
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { url } from '../data/url';
import type { LocalizedProject } from '../i18n/projects';
import { homePath, projectPath, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  project: LocalizedProject;
  prev?: LocalizedProject;
  next?: LocalizedProject;
}

const { lang, project, prev, next } = Astro.props;
const t = useTranslations(lang);
const { title, summary, category, date, dateEnd, cover, coverAlt, tags, role, duration, video, github, demo } = project.entry.data;
const { Content } = await render(project.entry);
const videoPoster = video?.poster ? await getImage({ src: video.poster, width: 720, format: 'webp' }) : undefined;

const locale = lang === 'pl' ? 'pl-PL' : 'en-GB';
const month = new Intl.DateTimeFormat(locale, { month: 'long' });
const monthYear = new Intl.DateTimeFormat(locale, { month: 'long', year: 'numeric' });
const dateLabel = !dateEnd
  ? monthYear.format(date)
  : date.getFullYear() === dateEnd.getFullYear()
    ? `${month.format(date)} – ${monthYear.format(dateEnd)}`
    : `${monthYear.format(date)} – ${monthYear.format(dateEnd)}`;
const specs = [
  [t('project.role'), role],
  [t('project.duration'), duration],
].filter((row): row is [string, string] => Boolean(row[1]));
---

<Base lang={lang} alternate={projectPath(lang === 'pl' ? 'en' : 'pl', project.slug)} title={title} description={summary}>
  <article>
    <header class="head">
      <div class="container">
        <a class="back" href={`${homePath(lang)}#projekty`}>← {t('project.back')}</a>
        <p class="label">{t(`cat.${category}`)} · {dateLabel}</p>
        <h1>{title}</h1>
        <p class="lead">{summary}</p>
        {
          (github || demo) && (
            <div class="links">
              {github && (
                <a class="btn btn-primary" href={github} target="_blank" rel="noopener noreferrer">
                  {t('project.github')}
                </a>
              )}
              {demo && (
                <a class="btn" href={demo} target="_blank" rel="noopener noreferrer">
                  {t('project.demo')}
                </a>
              )}
            </div>
          )
        }
      </div>
    </header>

    <div class="container">
      <figure class="cover">
        <Image src={cover} alt={coverAlt} widths={[800, 1200, 1600]} sizes="(max-width: 1040px) 100vw, 992px" loading="eager" />
      </figure>

      <div class="layout">
        <aside class="spec" aria-label={t('project.specAria')}>
          <dl>
            {
              specs.map(([label, value]) => (
                <div>
                  <dt>{label}</dt>
                  <dd>{value}</dd>
                </div>
              ))
            }
            {
              tags.length > 0 && (
                <div>
                  <dt>{t('projects.tech')}</dt>
                  <dd>
                    <ul class="tags">
                      {tags.map((tag) => (
                        <li class="tag">{tag}</li>
                      ))}
                    </ul>
                  </dd>
                </div>
              )
            }
          </dl>
        </aside>

        <div class="prose">
          {
            video && (
              <figure class="video">
                <video
                  controls
                  playsinline
                  preload="none"
                  poster={videoPoster?.src}
                  width={videoPoster?.attributes.width}
                  height={videoPoster?.attributes.height}
                >
                  <source src={url(video.src)} type="video/mp4" />
                </video>
                {video.caption && <figcaption>{video.caption}</figcaption>}
              </figure>
            )
          }
          <Content />
        </div>
      </div>

      <nav class="pager" aria-label={t('project.other')}>
        {
          prev ? (
            <a href={projectPath(lang, prev.slug)} class="pager-link">
              <span class="label">{t('project.newer')}</span>
              <strong>{prev.entry.data.title}</strong>
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a href={projectPath(lang, next.slug)} class="pager-link pager-next">
              <span class="label">{t('project.older')}</span>
              <strong>{next.entry.data.title}</strong>
            </a>
          )
        }
      </nav>
    </div>
  </article>
</Base>

<style>
  .head {
    padding: 48px 0 48px;
  }

  .back {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-bottom: 32px;
    color: var(--text-muted);
    font-size: 15px;
    text-decoration: none;
    transition: color 200ms var(--ease);
  }

  .back:hover {
    color: var(--text);
  }

  h1 {
    font-size: clamp(34px, 5vw, 52px);
    letter-spacing: -0.03em;
    margin: 12px 0 16px;
    max-width: 22ch;
  }

  .lead {
    font-size: clamp(17px, 2vw, 20px);
    color: var(--text-muted);
    max-width: 60ch;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .cover {
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface);
  }

  .cover :global(img) {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .layout {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 64px;
    padding: 64px 0 80px;
    align-items: start;
  }

  .spec {
    position: sticky;
    top: 96px;
  }

  .spec dl {
    margin: 0;
    display: grid;
    gap: 24px;
  }

  .spec dt {
    font-size: 13px;
    font-weight: 500;
    color: var(--text-muted);
  }

  .spec dd {
    margin: 4px 0 0;
    font-size: 15px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
  }

  /* Treść z pliku Markdown */
  .prose {
    font-size: 17px;
    line-height: 1.75;
    max-width: 68ch;
  }

  .prose :global(> * + *) {
    margin-top: 1.1em;
  }

  .prose :global(h2) {
    font-size: 26px;
    margin-top: 2.2em;
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(h3) {
    font-size: 20px;
    margin-top: 1.6em;
  }

  .prose :global(p),
  .prose :global(li) {
    color: var(--text-muted);
  }

  .prose :global(strong) {
    color: var(--text);
    font-weight: 600;
  }

  .prose :global(a) {
    color: var(--text);
    text-underline-offset: 3px;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.3em;
  }

  .prose :global(li + li) {
    margin-top: 0.4em;
  }

  .prose :global(img) {
    width: auto;
    max-height: 75vh;
    margin: 0 auto;
    border-radius: var(--radius);
  }

  .video {
    margin: 0 0 2em;
  }

  .video video {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 75vh;
    margin: 0 auto;
    background: #000;
    border-radius: var(--radius);
  }

  .video figcaption {
    margin-top: 10px;
    text-align: center;
    font-size: 14px;
    color: var(--text-muted);
  }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.88em;
    background: var(--surface);
    border-radius: 4px;
    padding: 1px 5px;
  }

  .prose :global(pre) {
    padding: 18px 20px;
    border-radius: var(--radius);
    overflow-x: auto;
    font-size: 14px;
    line-height: 1.6;
  }

  .prose :global(pre code) {
    background: none;
    padding: 0;
    font-size: inherit;
  }

  .prose :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 15px;
  }

  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    padding: 10px 14px;
    border-bottom: 1px solid var(--border);
  }

  .prose :global(th) {
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
  }

  .prose :global(blockquote) {
    margin-left: 0;
    padding: 4px 0 4px 20px;
    border-left: 2px solid var(--border-strong);
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    padding: 40px 0 96px;
    border-top: 1px solid var(--border);
  }

  .pager-link {
    display: grid;
    gap: 4px;
    text-decoration: none;
  }

  .pager-link strong {
    font-size: 18px;
    font-weight: 600;
  }

  .pager-link:hover strong {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .pager-next {
    text-align: right;
    grid-column: 2;
  }

  @media (max-width: 860px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
      padding-top: 40px;
    }

    .spec {
      position: static;
    }

    .spec dl {
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    }

    .spec dl div:has(.tags) {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 600px) {
    .pager {
      grid-template-columns: minmax(0, 1fr);
    }

    .pager-next {
      grid-column: auto;
    }
  }
</style>
